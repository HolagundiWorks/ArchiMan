<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="site_measurement.db" />
        <include domain="file" path="measurement_attachments/" />
        <include domain="sharedpref" path="measurement_drafts.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="site_measurement.db" />
        <include domain="file" path="measurement_attachments/" />
        <include domain="sharedpref" path="measurement_drafts.xml" />
    </device-transfer>
</data-extraction-rules>
